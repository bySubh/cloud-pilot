# ------------------------------------------------------------------
# Cloud Pilot — Backend configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- Google Cloud / Vertex AI -------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-1.5-pro

# If Vertex credentials are not configured, Cloud Pilot automatically
# falls back to a deterministic mock LLM so the pipeline remains runnable
# in local development and in tests. See app/llm/vertex.py.

# --- Terraform / Checkov safety ------------------------------------
# Cloud Pilot NEVER runs `terraform apply` unless this is explicitly "1".
SENTINEL_TF_ALLOW_APPLY=0
TERRAFORM_BINARY=terraform
CHECKOV_BINARY=checkov
TERRAFORM_TIMEOUT_SECONDS=120

# If the real `terraform` binary is not installed, run a clearly-labeled
# local static validator instead of skipping validation entirely (never
# presented as a real GCP plan). Set to 0 to instead report Terraform
# validation as "unavailable".
SENTINEL_ALLOW_MOCK_TERRAFORM=1

# Maximum self-healing attempts (bounded, provisioning-time only).
MAX_HEAL_ATTEMPTS=2

# --- Persistence -----------------------------------------------------
# If unset or unreachable, Cloud Pilot falls back to a local SQLite file
# at Backend/workspace/cloud_pilot.db
DATABASE_URL=

# --- RAG / Chroma ------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./.chroma
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- API / CORS ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO

# --- Frontend (used by Frontend/.env, documented here for convenience) ---
VITE_API_BASE_URL=http://localhost:8000
